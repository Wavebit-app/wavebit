{
  "name": "wavebit",
  "productName": "wavebit",
  "desktopName": "wavebit.desktop",
  "version": "1.0.0",
  "private": true,
  "description": "All your music in one open-source player: your files, Spotify and YouTube Music.",
  "keywords": [
    "electron",
    "music-player",
    "desktop-app",
    "spotify",
    "youtube-music"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Wavebit-app/wavebit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wavebit-app/wavebit.git"
  },
  "bugs": {
    "url": "https://github.com/Wavebit-app/wavebit/issues"
  },
  "author": "muchacho",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "native:build": "napi build --cwd native --release --dts index.d.ts",
    "native:test": "cargo test --manifest-path native/Cargo.toml",
    "tools:fetch": "node scripts/fetch-tools.mjs",
    "tools:update": "node scripts/fetch-tools.mjs --update",
    "test:js": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"src/**/*.test.ts\"",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "icons": "node scripts/build-icons.mjs",
    "banner": "electron scripts/build-banner.cjs",
    "prestart": "npm run tools:fetch && npm run native:build",
    "start": "electron-forge start",
    "prepackage": "npm run tools:fetch && npm run native:build",
    "package": "electron-forge package",
    "predist": "npm run tools:fetch && npm run native:build",
    "dist": "node scripts/build-release.mjs",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "audit:deps": "npm audit --omit=dev && cargo audit --file native/Cargo.lock",
    "check": "npm run typecheck && npm run lint && npm run test:js && npm run native:test"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@napi-rs/cli": "^3.10.12",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query-devtools": "^5.107.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "@internationalized/date": "^3.12.4",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "electron-store": "^12.0.0",
    "electron-updater": "6.8.11",
    "lucide-react": "^1.70.0",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "tailwind-variants": "^4.0.1",
    "zod": "^4.6.7"
  }
}
